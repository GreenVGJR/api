{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": false,
		"types": ["bun"],
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"watchOptions": {
		"excludeDirectories": ["**/node_modules", "**/.venv", "**/.git", "**/__pycache__"]
	},
	"exclude": ["node_modules", ".venv", "**/__pycache__/**", "functions/tiktok_signature", "dist", "build", "test", "public", "html", "amc", "database", "tsconfig.tsbuildinfo", "**/*.md", "**/*.py", "**/*.pyc"],
	"include": ["index.ts", "app.ts", "gen-routes.ts", "functions/**/*.ts", "routes/**/*.ts"]
}
